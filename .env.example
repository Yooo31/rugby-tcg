# Copier ce fichier en .env.local et le remplir. Ne jamais commiter .env.local.

# Supabase > Settings > API
NEXT_PUBLIC_SUPABASE_URL="https://<ref>.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."

# Supabase > Connect > Transaction pooler (port 6543) : utilisée par l'application.
DATABASE_URL="postgresql://postgres.<ref>:<mot-de-passe>@<hote-pooler>:6543/postgres?pgbouncer=true&connection_limit=1"
# Supabase > Connect > Session pooler ou connexion directe (port 5432) : migrations Prisma.
DIRECT_URL="postgresql://postgres.<ref>:<mot-de-passe>@<hote-pooler>:5432/postgres"

# Adresse publique du site, pour les liens des e-mails d'authentification.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Administration : adresses e-mail des administrateurs, séparées par des virgules.
# Lue uniquement par le serveur. Vide = personne n'a accès à /admin.
ADMIN_EMAILS=""

# Notifications (Web Push). Générer une paire : npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
# Adresse de contact transmise aux services de notification des navigateurs.
VAPID_SUBJECT="mailto:contact@yoanmartins.fr"
# Secret exigé par la tâche planifiée /api/cron/notifications (en-tête Authorization: Bearer …).
CRON_SECRET=""

# Suivi des erreurs (Sentry, offre gratuite). Vide = Sentry éteint.
# Le DSN n'est pas un secret (il finit dans le code du navigateur).
NEXT_PUBLIC_SENTRY_DSN=""
# Facultatif sur Vercel : à défaut, l'environnement vient de VERCEL_ENV
# (« production » ou « preview »). Utile en local : "development".
SENTRY_ENVIRONMENT=""
NEXT_PUBLIC_SENTRY_ENVIRONMENT=""
SENTRY_ORG=""
SENTRY_PROJECT=""
# Secret : envoi des source maps au build (Settings > Auth Tokens). Jamais commité.
SENTRY_AUTH_TOKEN=""

# Paiement Stripe (mode test : clés sk_test_… ; sans elles, les boutons
# de paiement répondent « indisponible »). Secret du webhook : celui de
# l'endpoint créé dans Stripe, ou celui affiché par `stripe listen` en local.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
