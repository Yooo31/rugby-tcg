{
  "branches": ["main"],
  "tagFormat": "v${version}",
  "plugins": [
    ["@semantic-release/commit-analyzer", { "preset": "conventionalcommits" }],
    [
      "@semantic-release/release-notes-generator",
      {
        "preset": "conventionalcommits",
        "presetConfig": {
          "types": [
            { "type": "feat", "section": "Nouveautés" },
            { "type": "fix", "section": "Corrections" },
            { "type": "perf", "section": "Performances" },
            { "type": "revert", "section": "Retours en arrière" },
            { "type": "refactor", "section": "Restructuration" },
            { "type": "docs", "section": "Documentation" },
            { "type": "build", "section": "Construction et dépendances" },
            { "type": "chore", "hidden": true },
            { "type": "ci", "hidden": true },
            { "type": "test", "hidden": true },
            { "type": "style", "hidden": true }
          ]
        }
      }
    ],
    [
      "@semantic-release/github",
      { "successComment": false, "failComment": false }
    ]
  ]
}
